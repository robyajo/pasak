{
    "name": "robyajo/pasak",
    "description": "Pasak - enterprise-grade headless self-hosted WAF, threat detection engine, zero-tolerance blocking, stepped login lockout, and security auditing toolkit for Laravel.",
    "keywords": [
        "laravel",
        "security",
        "waf",
        "firewall",
        "threat-detection",
        "ip-blocking",
        "brute-force",
        "login-throttle",
        "webshell-scanner",
        "security-audit",
        "headless"
    ],
    "homepage": "https://github.com/robyajo/pasak",
    "support": {
        "issues": "https://github.com/robyajo/pasak/issues",
        "source": "https://github.com/robyajo/pasak",
        "docs": "https://github.com/robyajo/pasak#readme"
    },
    "funding": [
        {
            "type": "custom",
            "url": "https://saweria.co/robykartis"
        }
    ],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Roby",
            "email": "robyfull.dev@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2|^8.3|^8.4|^8.5",
        "guzzlehttp/guzzle": "^7.8|^8.0",
        "illuminate/auth": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/console": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/routing": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^8.0|^9.0|^10.0|^11.0",
        "pestphp/pest": "^2.0|^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^2.0|^3.0|^4.0"
    },
    "suggest": {
        "livewire/livewire": "Required for the optional Livewire Starter Kit monitoring dashboard (vendor:publish --tag=starterkit-livewire).",
        "inertiajs/inertia-laravel": "Required for the optional React Starter Kit monitoring dashboard (vendor:publish --tag=starterkit-react)."
    },
    "autoload": {
        "psr-4": {
            "Internal\\Pasak\\": "src/"
        },
        "files": [
            "src/compat.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Internal\\Pasak\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "analyse": "phpstan analyse",
        "format": "pint",
        "lint": "pint --test",
        "dev:tools": "composer require --dev larastan/larastan laravel/pint --no-interaction"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Internal\\Pasak\\PasakServiceProvider"
            ],
            "aliases": {
                "Pasak": "Internal\\Pasak\\Facades\\Pasak",
                "SecurityMonitor": "Internal\\Pasak\\Facades\\Pasak"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block": false
        },
        "policy": {
            "advisories": {
                "block": false
            }
        }
    },
    "archive": {
        "exclude": [
            "/.agents",
            "/AGENTS.md",
            "/documents",
            "/web",
            "/.github",
            "/.gitattributes",
            "/.gitignore",
            "/push.sh",
            "/paparan"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}