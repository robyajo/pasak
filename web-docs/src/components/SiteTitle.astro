---
// Override SiteTitle: tambahkan badge versi paket di samping judul situs.
// Desktop & mobile: Logo + "Pasak".
import { logos } from "virtual:starlight/user-images";
import config from "virtual:starlight/user-config";
import pkg from "../data/package.json";

const { siteTitleHref } = Astro.locals.starlightRoute;
const version = pkg.packagist?.version ?? pkg.version;
---

<a href={siteTitleHref} class="site-title sl-flex">
	{
		config.logo && logos.dark && (
			<>
				<img
					class:list={{ "light:sl-hidden print:hidden": !("src" in config.logo) }}
					alt={config.logo.alt}
					src={logos.dark.src}
					width={logos.dark.width}
					height={logos.dark.height}
				/>
				{!('src' in config.logo) && (
					<img
						class="dark:sl-hidden print:block"
						alt={config.logo.alt}
						src={logos.light?.src}
						width={logos.light?.width}
						height={logos.light?.height}
					/>
				)}
			</>
		)
	}
	<span class="site-title-text" translate="no">
		<span class="title-product">Pasak</span>
	</span>
</a>

<a
	class="pkg-version"
	href={pkg.packagist.url}
	target="_blank"
	rel="noopener"
	title={`Versi terbaru paket di Packagist: v${version}`}
>
	v{version}
</a>

<script is:inline>
	(() => {
		const updateLiveVersion = () => {
			const badge = document.querySelector('.pkg-version');
			if (!badge) return;

			const CACHE_KEY = 'pasak_packagist_version';
			const CACHE_TIME_KEY = 'pasak_packagist_time';
			const now = Date.now();

			try {
				const cached = sessionStorage.getItem(CACHE_KEY);
				const cachedTime = parseInt(sessionStorage.getItem(CACHE_TIME_KEY) || '0', 10);
				if (cached && now - cachedTime < 600000) {
					badge.textContent = 'v' + cached.replace(/^v/, '');
					badge.title = 'Versi terbaru paket di Packagist: v' + cached.replace(/^v/, '');
					return;
				}
			} catch (_) {}

			fetch('https://packagist.org/packages/robyajo/pasak.json')
				.then((res) => (res.ok ? res.json() : null))
				.then((data) => {
					if (!data?.package?.versions) return;
					const versions = Object.keys(data.package.versions);
					const stable = versions.find((v) => /^v?\d+\.\d+\.\d+$/.test(v));
					if (stable) {
						const clean = stable.replace(/^v/, '');
						badge.textContent = 'v' + clean;
						badge.title = 'Versi terbaru paket di Packagist: v' + clean;
						try {
							sessionStorage.setItem(CACHE_KEY, clean);
							sessionStorage.setItem(CACHE_TIME_KEY, String(now));
						} catch (_) {}
					}
				})
				.catch(() => {});
		};

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', updateLiveVersion);
		} else {
			updateLiveVersion();
		}
		document.addEventListener('astro:page-load', updateLiveVersion);
	})();
</script>

<style>
	:global(.title-wrapper) {\n		gap: 0.75rem;\n		align-items: center;\n	}\n\n	.site-title {\n		align-items: center;\n		gap: var(--sl-nav-gap, 0.75rem);\n		font-size: var(--sl-text-h4, 1.05rem);\n		font-family: var(--sl-font) !important;\n		font-weight: 700 !important;\n		letter-spacing: -0.02em !important;\n		color: var(--sl-color-white) !important;\n		text-decoration: none;\n		white-space: nowrap;\n		min-width: 0;\n		transition: opacity 0.15s ease;\n	}\n\n	.site-title:hover {\n		color: var(--sl-color-accent) !important;\n	}\n\n	.site-title img {\n		height: calc(var(--sl-nav-height, 3.5rem) - 2 * var(--sl-nav-pad-y, 0.75rem));\n		width: auto;\n		max-width: 100%;\n		object-fit: contain;\n		object-position: 0 50%;\n	}\n\n	.site-title-text {\n		overflow: hidden;\n		text-overflow: ellipsis;\n		white-space: nowrap;\n	}\n\n	.title-brand {\n		display: inline;\n	}\n\n	.title-product {\n		display: inline;\n	}\n\n	.pkg-version {\n		align-self: center;\n		flex: none;\n		display: inline-flex;\n		align-items: center;\n		margin-inline-start: 0.75rem;\n		padding: 0.15rem 0.6rem;\n		border: 1px solid var(--sl-color-gray-5);\n		border-radius: 999px;\n		font-family: var(--sl-font-mono);\n		font-size: var(--sl-text-xs);\n		font-weight: 600;\n		line-height: 1.4;\n		color: var(--sl-color-text-accent);\n		background-color: var(--sl-color-gray-6);\n		text-decoration: none;\n		white-space: nowrap;\n		transition: border-color 0.15s ease, background-color 0.15s ease;\n	}\n\n	.pkg-version:hover {\n		border-color: var(--sl-color-accent);\n		background-color: var(--sl-color-accent-low);\n	}\n\n	/* Tampilan Responsif Mobile: Tampilkan Icon + \"Pasak\" */\n	@media (max-width: 50rem) {\n		:global(.title-wrapper) {\n			gap: 0.5rem !important;\n			padding: 0 !important;\n			margin: 0 !important;\n		}\n\n		.site-title {\n			gap: 0.5rem !important;\n			padding: 0.2rem 0 !important;\n			font-size: 0.95rem !important;\n			font-weight: 700 !important;\n		}\n\n		.site-title img {\n			height: 1.85rem !important;\n			width: auto !important;\n			max-height: 100% !important;\n			display: block !important;\n			object-fit: contain !important;\n		}\n\n		/* Judul \"Pasak\" yang ringkas muat dengan rapi di layar sempit */\n		.title-brand {\n			display: none !important;\n		}\n\n		.title-product {\n			display: inline !important;\n			font-weight: 700 !important;\n			color: var(--sl-color-white) !important;\n		}\n\n		.pkg-version {\n			display: none !important;\n		}\n	}\n</style>\n
