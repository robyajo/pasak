---
import EditLink from "virtual:starlight/components/EditLink";
import LastUpdated from "virtual:starlight/components/LastUpdated";
import Pagination from "virtual:starlight/components/Pagination";
import pkg from "../data/package.json";
import { Image } from "astro:assets";
import logo from "../assets/logo.svg";

// Periksa apakah halaman saat ini adalah halaman beranda (/)
const { entry } = Astro.locals.starlightRoute;
const pathname = Astro.url.pathname;
const isHome =
    entry?.data?.template === "splash" || pathname === "/" || pathname === "";

const year = new Date().getFullYear();
const version = pkg?.packagist?.version ?? pkg?.version ?? "1.2.3";
const installCmd = "composer require robyajo/pasak";

const navColumns = [
    {
        heading: "Panduan Memulai",
        links: [
            {
                label: "Pengenalan Pasak Security",
                href: "/getting-started/introduction/",
                badge: "Dasar",
            },
            {
                label: "Instalasi & Migrasi Database",
                href: "/getting-started/installation/",
            },
            {
                label: "Konfigurasi Lengkap (.env)",
                href: "/getting-started/configuration/",
            },
            {
                label: "Checklist Produksi Siap Pakai",
                href: "/webserver-hardening/production-checklist/",
                badge: "Penting",
            },
        ],
    },
    {
        heading: "Arsitektur & Mesin",
        links: [
            {
                label: "Mesin Deteksi Ancaman WAF",
                href: "/core-architecture/threat-detection-engine/",
            },
            {
                label: "Karantina Perangkat (NAT Friendly)",
                href: "/core-architecture/device-quarantine/",
            },
            {
                label: "Resolusi Real IP Reverse Proxy",
                href: "/core-architecture/reverse-proxy-resolution/",
            },
            {
                label: "Model Database & Relasi Eloquent",
                href: "/core-architecture/models-and-database/",
            },
        ],
    },
    {
        heading: "Modul Pertahanan",
        links: [
            {
                label: "Stepped Login Throttling",
                href: "/security-modules/stepped-login-throttling/",
            },
            {
                label: "Pemindai Webshell & SHA-256",
                href: "/security-modules/server-security-and-webshells/",
            },
            {
                label: "Sistem Tiket Banding IP",
                href: "/security-modules/appeal-tickets-system/",
            },
            {
                label: "Pemantau Log Akses & Streaming",
                href: "/security-modules/access-log-streaming/",
            },
            {
                label: "Pelacakan Sesi & Aktivitas",
                href: "/security-modules/session-and-activity-tracking/",
            },
        ],
    },
    {
        heading: "Ekosistem & Integrasi",
        links: [
            {
                label: "REST API Headless (Admin & Publik)",
                href: "/api-reference/api-overview/",
            },
            {
                label: "Perintah Artisan & Penjadwalan",
                href: "/cli-automation/artisan-commands/",
            },
            {
                label: "Hardening Nginx & Apache",
                href: "/webserver-hardening/nginx-hardened-waf/",
            },
            {
                label: "Integrasi Blade & React Inertia",
                href: "/integration-guides/frontend-blade-livewire/",
            },
            {
                label: "Pertanyaan Umum (FAQ)",
                href: "/faq/",
            },
            {
                label: "Catatan Rilis (Changelog)",
                href: "/changelog/",
            },
        ],
    },
];

const highlights = [
    {
        icon: "shield-check",
        title: "Zero-Tolerance WAF",
        desc: "Blokir instan 30 hari untuk signature berbahaya: null byte, traversal, & webshell.",
    },
    {
        icon: "device",
        title: "Karantina Perangkat",
        desc: "Isolasi penyerang pada level perangkat tanpa blokir subnet IP NAT bersama.",
    },
    {
        icon: "clock",
        title: "Login Bertingkat",
        desc: "Lockout eksponensial 1 menit s.d. 24 jam melawan brute force & credential stuffing.",
    },
    {
        icon: "file-code",
        title: "Audit Integritas File",
        desc: "Baseline SHA-256 file framework inti & pemindai webshell otomatis berkala.",
    },
];
---

<footer class="sl-flex pk-footer-wrapper">
    {/* Halaman Dokumentasi: Footer minimalis, bersih, tanpa distraksi */}
    {!isHome ? (
        <>
            <div class="meta sl-flex">
                <EditLink />
                <LastUpdated />
            </div>
            <Pagination />
            <div class="pk-doc-footer">
                <p>
                    &copy; {year} <strong>Pasak (Bulwark)</strong> &bull;
                    Lisensi Open-Source MIT &bull; Diskominfo Kota Pekanbaru
                </p>
            </div>
        </>
    ) : (
        /* Halaman Beranda (/): Tampilan Neobrutalism Modern & Minimalis */
        <div
            class="pk-footer"
            role="contentinfo"
            aria-label="Footer Pasak Security"
        >
            {/* Top Brand & Actions */}
            <div class="pk-footer-top">
                <div class="pk-footer-brand">
                    <div class="pk-footer-brand-title">
                        <a
                            href="/"
                            class="pk-footer-logo-link"
                            aria-label="Beranda Pasak"
                        >
                            <Image
                                src={logo}
                                alt="Logo Pasak"
                                width={32}
                                height={32}
                                class="pk-footer-logo"
                            />
                        </a>
                        <div class="pk-footer-title-text">
                            <span class="pk-brand-name">Pasak</span>
                            <span class="pk-brand-tag">Bulwark WAF</span>
                        </div>
                    </div>

                    <p class="pk-footer-desc">
                        Web Application Firewall mandiri &amp; modul audit
                        keamanan <strong>100% Native PHP</strong> untuk
                        <strong>Laravel 10–13</strong>. Standar ketahanan siber
                        sistem informasi pemerintahan dan enterprise.
                    </p>

                    <div class="pk-footer-meta-pills">
                        <a
                            href={
                                pkg?.packagist?.url ??
                                "https://packagist.org/packages/robyajo/pasak"
                            }
                            target="_blank"
                            rel="noopener"
                            class="pk-pill pk-pill-version"
                            title="Versi paket rilis terbaru di Packagist"
                        >
                            <span class="pk-dot" aria-hidden="true"></span>
                            <span>v{version}</span>
                            <span class="pk-pill-sub">Stabil</span>
                        </a>

                        <span class="pk-pill pk-pill-neutral">
                            <svg
                                width="13"
                                height="13"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                            </svg>
                            <span>Pure PHP (Zero NPM)</span>
                        </span>

                        <span class="pk-pill pk-pill-neutral">
                            <svg
                                width="13"
                                height="13"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <rect
                                    x="2"
                                    y="3"
                                    width="20"
                                    height="14"
                                    rx="2"
                                    ry="2"
                                />
                                <line x1="8" y1="21" x2="16" y2="21" />
                                <line x1="12" y1="17" x2="12" y2="21" />
                            </svg>
                            <span>Laravel 10 – 13</span>
                        </span>
                    </div>
                </div>

                <div class="pk-footer-actions">
                    <div class="pk-install-box">
                        <span class="pk-install-label">
                            Instalasi Composer:
                        </span>
                        <button
                            type="button"
                            class="pk-copy-btn"
                            data-copy={installCmd}
                            aria-label="Salin perintah composer require robyajo/pasak"
                            title="Klik untuk menyalin"
                        >
                            <span class="pk-copy-prompt">$</span>
                            <code class="pk-copy-code">{installCmd}</code>
                            <span class="pk-copy-icon" aria-hidden="true">
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        x="9"
                                        y="9"
                                        width="13"
                                        height="13"
                                        rx="2"
                                        ry="2"
                                    ></rect>
                                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                                </svg>
                            </span>
                            <span class="pk-copy-feedback" aria-live="polite">
                                Tersalin!
                            </span>
                        </button>
                    </div>

                    <div class="pk-social-links">
                        <a
                            href={
                                pkg?.repository ??
                                "https://github.com/robyajo/pasak"
                            }
                            target="_blank"
                            rel="noopener"
                            class="pk-social-btn"
                            aria-label="GitHub robyajo/pasak"
                        >
                            <svg
                                width="15"
                                height="15"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.3 1.15-.3 2.35 0 3.5A5.403 5.403 0 0 0 4 9c0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4" />
                                <path d="M9 18c-4.51 2-5-2-7-2" />
                            </svg>
                            <span>GitHub</span>
                        </a>

                        <a
                            href={
                                pkg?.packagist?.url ??
                                "https://packagist.org/packages/robyajo/pasak"
                            }
                            target="_blank"
                            rel="noopener"
                            class="pk-social-btn"
                            aria-label="Packagist robyajo/pasak"
                        >
                            <svg
                                width="15"
                                height="15"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                                <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                            </svg>
                            <span>Packagist</span>
                        </a>

                        <a
                            href="https://security-dev.pekanbaru.go.id"
                            target="_blank"
                            rel="noopener"
                            class="pk-social-btn pk-social-btn-csirt"
                            aria-label="Portal Keamanan Siber Pekanbaru"
                        >
                            <svg
                                width="15"
                                height="15"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                aria-hidden="true"
                            >
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                <circle cx="12" cy="11" r="3" />
                            </svg>
                            <span>CSIRT</span>
                        </a>
                    </div>
                </div>
            </div>

            {/* 4 Pilar Keamanan Pasak (Neobrutalism Cards) */}
            <div class="pk-footer-highlights">
                {highlights.map((h) => (
                    <div class="pk-highlight-card">
                        <div class="pk-highlight-icon" aria-hidden="true">
                            {h.icon === "shield-check" && (
                                <svg
                                    width="15"
                                    height="15"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                    <polyline points="9 12 11 14 15 10" />
                                </svg>
                            )}
                            {h.icon === "device" && (
                                <svg
                                    width="15"
                                    height="15"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        x="2"
                                        y="3"
                                        width="20"
                                        height="14"
                                        rx="2"
                                        ry="2"
                                    />
                                    <line x1="8" y1="21" x2="16" y2="21" />
                                </svg>
                            )}
                            {h.icon === "clock" && (
                                <svg
                                    width="15"
                                    height="15"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <circle cx="12" cy="12" r="10" />
                                    <polyline points="12 6 12 12 16 14" />
                                </svg>
                            )}
                            {h.icon === "file-code" && (
                                <svg
                                    width="15"
                                    height="15"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
                                    <polyline points="14 2 14 8 20 8" />
                                    <polyline points="10 13 8 15 10 17" />
                                    <polyline points="14 13 16 15 14 17" />
                                </svg>
                            )}
                        </div>
                        <div class="pk-highlight-text">
                            <p class="pk-highlight-title">{h.title}</p>
                            <p class="pk-highlight-desc">{h.desc}</p>
                        </div>
                    </div>
                ))}
            </div>

            {/* Navigasi 4 Kolom */}
            <div class="pk-footer-nav-grid">
                {navColumns.map((col) => (
                    <nav class="pk-footer-col" aria-label={col.heading}>
                        <p class="pk-footer-heading">
                            <span
                                class="pk-heading-indicator"
                                aria-hidden="true"
                            ></span>
                            {col.heading}
                        </p>
                        <ul class="pk-footer-links">
                            {col.links.map((link) => (
                                <li>
                                    <a href={link.href} class="pk-footer-link">
                                        <span>{link.label}</span>
                                        {link.badge && (
                                            <span class="pk-link-badge">
                                                {link.badge}
                                            </span>
                                        )}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </nav>
                ))}
            </div>

            {/* Bottom Bar: Copyright & Akreditasi */}
            <div class="pk-footer-bottom">
                <div class="pk-bottom-left">
                    <p class="pk-bottom-copy">
                        &copy; {year} <strong>Pasak (Bulwark)</strong> &mdash;
                        Berlisensi Open-Source MIT.
                    </p>
                    <p class="pk-bottom-author">
                        Dikembangkan oleh <strong>Roby Karti S.</strong> untuk
                        Ekosistem Keamanan Laravel.
                    </p>
                </div>

                <div class="pk-bottom-right">
                    <a
                        href="https://security-dev.pekanbaru.go.id"
                        target="_blank"
                        rel="noopener"
                        class="pk-pekanbaru-badge"
                        title="Kunjungi Portal Keamanan Siber Diskominfo Kota Pekanbaru"
                    >
                        <span class="pk-seal-icon" aria-hidden="true">
                            <svg
                                width="15"
                                height="15"
                                viewBox="0 0 24 24"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2.5"
                                stroke-linecap="round"
                                stroke-linejoin="round"
                            >
                                <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" />
                                <polyline points="9 12 11 14 15 10" />
                            </svg>
                        </span>
                        <span class="pk-pekanbaru-text">
                            <span class="pk-pekanbaru-gov">
                                Pemerintah Kota Pekanbaru
                            </span>
                            <span class="pk-pekanbaru-dept">
                                Diskominfo Kota Pekanbaru
                            </span>
                        </span>
                        <span class="pk-ext-arrow" aria-hidden="true">
                            &nearr;
                        </span>
                    </a>
                </div>
            </div>
        </div>
    )}
</footer>

<script>
    // Copy button dengan tactile feedback
    const setupCopyButtons = () => {
        const copyBtns =
            document.querySelectorAll<HTMLButtonElement>(".pk-copy-btn");
        if (!copyBtns.length) return;

        copyBtns.forEach((btn) => {
            btn.addEventListener("click", async () => {
                const text = btn.getAttribute("data-copy");
                if (!text) return;

                try {
                    await navigator.clipboard.writeText(text);
                    btn.classList.add("is-copied");
                    setTimeout(() => {
                        btn.classList.remove("is-copied");
                    }, 2000);
                } catch {
                    const textarea = document.createElement("textarea");
                    textarea.value = text;
                    textarea.style.position = "fixed";
                    textarea.style.opacity = "0";
                    document.body.appendChild(textarea);
                    textarea.select();
                    try {
                        document.execCommand("copy");
                        btn.classList.add("is-copied");
                        setTimeout(
                            () => btn.classList.remove("is-copied"),
                            2000,
                        );
                    } finally {
                        document.body.removeChild(textarea);
                    }
                }
            });
        });
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupCopyButtons);
    } else {
        setupCopyButtons();
    }
</script>

<style>
    /* ==========================================================================
       CONTAINER & DOKUMENTASI MINIMAL FOOTER
       ========================================================================== */
    .pk-footer-wrapper {
        display: flex;
        flex-direction: column;
        gap: 1.25rem;
        margin-top: 2rem;
    }

    .pk-doc-footer {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 2px solid var(--sl-color-hairline);
        text-align: center;
        font-size: 0.8rem;
        line-height: 1.5;
        color: var(--sl-color-gray-4);
    }

    .pk-doc-footer p {
        margin: 0;
    }

    .pk-doc-footer strong {
        color: var(--sl-color-gray-2);
        font-weight: 700;
    }

    /* ==========================================================================
       HOMEPAGE NEOBRUTALISM FOOTER (SOLID BORDER + HARD SHADOW, NO BLUR)
       ========================================================================== */
    .pk-footer {
        position: relative;
        margin-top: 1.5rem;
        padding: 2rem 1.75rem 1.5rem;
        border-radius: 0.625rem;
        border: 2px solid var(--sl-color-hairline);
        background: var(--sl-color-gray-6);
        box-shadow: 4px 4px 0px var(--pk-shadow);
        font-family: var(--sl-font);
        font-size: var(--sl-text-sm);
        color: var(--sl-color-gray-2);
    }

    /* ==========================================================================
       TOP ROW: BRAND & ACTIONS
       ========================================================================== */
    .pk-footer-top {
        display: flex;
        flex-direction: column;
        gap: 1.75rem;
        padding-bottom: 1.75rem;
        border-bottom: 2px solid var(--sl-color-hairline);
    }

    @media (min-width: 58rem) {
        .pk-footer-top {
            flex-direction: row;
            align-items: flex-start;
            justify-content: space-between;
        }
    }

    .pk-footer-brand {
        max-width: 36rem;
    }

    .pk-footer-brand-title {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        margin-bottom: 0.75rem;
    }

    .pk-footer-logo-link {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transform: translate(0, 0);
        transition: transform 120ms cubic-bezier(0.16, 1, 0.3, 1);
    }

    .pk-footer-logo-link:hover {
        transform: translate(2px, 2px);
    }

    .pk-footer-logo {
        border-radius: 0.375rem;
    }

    .pk-footer-title-text {
        display: flex;
        align-items: baseline;
        gap: 0.5rem;
    }

    .pk-brand-name {
        font-size: 1.35rem;
        font-weight: 800;
        letter-spacing: -0.03em;
        color: var(--sl-color-white);
    }

    .pk-brand-tag {
        font-size: 0.7rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 0.15rem 0.5rem;
        border-radius: 0.25rem;
        background: #38bdf8;
        color: #000;
        border: 2px solid #0f172a;
        box-shadow: 2px 2px 0px #0f172a;
    }

    :global(:root[data-theme="dark"]) .pk-brand-tag {
        background: var(--sl-color-accent);
        color: #000;
        border: 2px solid #000;
        box-shadow: 2px 2px 0px #000;
    }

    .pk-footer-desc {
        margin: 0 0 1rem;
        font-size: 0.875rem;
        line-height: 1.6;
        color: var(--sl-color-gray-2);
        max-width: 34rem;
    }

    .pk-footer-desc strong {
        color: var(--sl-color-white);
        font-weight: 700;
    }

    .pk-footer-meta-pills {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0.5rem;
    }

    .pk-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.25rem 0.65rem;
        border-radius: 0.375rem;
        border: 2px solid var(--sl-color-hairline);
        box-shadow: 2px 2px 0px var(--pk-shadow);
        font-size: 0.75rem;
        font-weight: 700;
        text-decoration: none;
        line-height: 1;
        background: var(--sl-color-gray-6);
        color: var(--sl-color-white);
        transform: translate(0, 0);
        transition:
            transform 120ms cubic-bezier(0.16, 1, 0.3, 1),
            box-shadow 120ms cubic-bezier(0.16, 1, 0.3, 1),
            border-color 120ms ease;
    }

    .pk-pill:hover {
        transform: translate(1px, 1px) !important;
        box-shadow: 1px 1px 0px var(--pk-shadow) !important;
    }

    .pk-pill:active {
        transform: translate(2px, 2px) !important;
        box-shadow: 0px 0px 0px var(--pk-shadow) !important;
    }

    .pk-pill-version {
        border-color: #059669;
        color: #065f46;
        background: #ecfdf5;
    }

    :global(:root[data-theme="dark"]) .pk-pill-version {
        border-color: #34d399;
        color: #34d399;
        background: transparent;
    }

    .pk-pill-sub {
        font-weight: 500;
        opacity: 0.85;
    }

    .pk-dot {
