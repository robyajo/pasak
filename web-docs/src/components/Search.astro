---
// Komponen Pencarian Kustom Pasak (Neobrutalism UI)
// Membungkus pencarian bawaan Starlight (Pagefind) dan menambahkan
// saran kata kunci populer tepat di bawah input pencarian dengan ikon SVG yang presisi.
import DefaultSearch from "@astrojs/starlight/components/Search.astro";

const searchSuggestions = [
    {
        label: "Install & Setup",
        query: "composer require robyajo/pasak",
        type: "package",
    },
    {
        label: "WAF Rules",
        query: "waf zero tolerance instant block",
        type: "shield",
    },
    {
        label: "Karantina Perangkat",
        query: "device quarantine fingerprint",
        type: "device",
    },
    {
        label: "Stepped Throttle",
        query: "login throttle lockout delay",
        type: "clock",
    },
    {
        label: "Webshell Scan",
        query: "audit webshell baseline sha256",
        type: "search",
    },
    {
        label: "REST API",
        query: "api reference headless endpoint",
        type: "zap",
    },
    {
        label: "Nginx Hardening",
        query: "webserver hardening nginx config",
        type: "lock",
    },
];
---

<div class="pk-search-container">
    <DefaultSearch>
        <slot />
    </DefaultSearch>

    <!-- Template saran pencarian yang akan disuntikkan ke dalam dialog pencarian Pagefind -->
    <template id="pk-suggestions-template">
        <div class="pk-search-suggestions">
            <div class="pk-suggestions-header">
                <span class="pk-suggestions-icon" aria-hidden="true">
                    <svg
                        width="15"
                        height="15"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                    >
                        <path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"></path>
                        <path d="M9 18h6"></path>
                        <path d="M10 22h4"></path>
                    </svg>
                </span>
                <span>Saran Pencarian Populer:</span>
            </div>
            <div class="pk-suggestions-chips">
                {searchSuggestions.map((item) => (
                    <button
                        type="button"
                        class="pk-suggestion-chip"
                        data-query={item.query}
                        title={`Cari "${item.query}"`}
                    >
                        <span class="pk-chip-icon" aria-hidden="true">
                            {item.type === "package" && (
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path>
                                    <polyline points="3.29 7 12 12 20.71 7"></polyline>
                                    <line
                                        x1="12"
                                        y1="22"
                                        x2="12"
                                        y2="12"
                                    ></line>
                                </svg>
                            )}
                            {item.type === "shield" && (
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"></path>
                                </svg>
                            )}
                            {item.type === "device" && (
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        width="14"
                                        height="20"
                                        x="5"
                                        y="2"
                                        rx="2"
                                        ry="2"
                                    ></rect>
                                    <line
                                        x1="12"
                                        y1="18"
                                        x2="12.01"
                                        y2="18"
                                    ></line>
                                </svg>
                            )}
                            {item.type === "clock" && (
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <circle cx="12" cy="12" r="10"></circle>
                                    <polyline points="12 6 12 12 16 14"></polyline>
                                </svg>
                            )}
                            {item.type === "search" && (
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <circle cx="11" cy="11" r="8"></circle>
                                    <line
                                        x1="21"
                                        y1="21"
                                        x2="16.65"
                                        y2="16.65"
                                    ></line>
                                </svg>
                            )}
                            {item.type === "zap" && (
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon>
                                </svg>
                            )}
                            {item.type === "lock" && (
                                <svg
                                    width="14"
                                    height="14"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="2.5"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                >
                                    <rect
                                        width="18"
                                        height="11"
                                        x="3"
                                        y="11"
                                        rx="2"
                                        ry="2"
                                    ></rect>
                                    <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
                                </svg>
                            )}
                        </span>
                        <span class="pk-chip-label">{item.label}</span>
                    </button>
                ))}
            </div>
        </div>
    </template>
</div>

<script>
    // Menyuntikkan wadah saran pencarian ke dalam modal pencarian Pagefind saat dibuka
    const setupSearchSuggestions = () => {
        const template = document.getElementById(
            "pk-suggestions-template",
        ) as HTMLTemplateElement | null;
        if (!template) return;

        // Amati penambahan dialog Pagefind atau buka dialog
        const attachSuggestions = () => {
            const dialog = document.querySelector("dialog#starlight__search");
            if (!dialog) return;

            // Cari input search Pagefind
            const searchForm = dialog.querySelector(".pagefind-ui__form");
            if (!searchForm) return;

            // Periksa apakah saran sudah disuntikkan sebelumnya
            if (dialog.querySelector(".pk-search-suggestions")) return;

            const clone = template.content.cloneNode(true) as DocumentFragment;
            const suggestionsEl = clone.querySelector(".pk-search-suggestions");

            if (suggestionsEl) {
                // Sisipkan tepat di bawah form pencarian Pagefind
                searchForm.insertAdjacentElement("afterend", suggestionsEl);

                // Tambahkan event click ke setiap chip saran
                const chips = suggestionsEl.querySelectorAll<HTMLButtonElement>(
                    ".pk-suggestion-chip",
                );
                chips.forEach((chip) => {
                    chip.addEventListener("click", () => {
                        const query = chip.dataset.query;
                        if (!query) return;

                        const input = dialog.querySelector<HTMLInputElement>(
                            ".pagefind-ui__search-input",
                        );
                        if (input) {
                            input.value = query;
                            // Picu event input agar Pagefind langsung melakukan pencarian
                            input.dispatchEvent(
                                new Event("input", { bubbles: true }),
                            );
                            input.focus();
                        }
                    });
                });
            }
        };

        // Pasang observer untuk mendeteksi saat modal pencarian dibuka
        const observer = new MutationObserver(() => {
            attachSuggestions();
        });

        observer.observe(document.body, {
            childList: true,
            subtree: true,
        });

        // Jalankan sekali saat inisialisasi
        attachSuggestions();
    };

    if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupSearchSuggestions);
    } else {
        setupSearchSuggestions();
    }
    document.addEventListener("astro:page-load", setupSearchSuggestions);
</script>

<style is:global>
    /* ==========================================================================
       STYLING SARAN PENCARIAN & MODAL (NEOBRUTALISM STYLE)
       ========================================================================== */
    dialog {
        background-color: #ffffff !important;
        border: 2px solid var(--sl-color-hairline) !important;
        border-radius: 0.625rem !important;
        box-shadow: 6px 6px 0px var(--pk-shadow) !important;
    }

    dialog::backdrop {
        background-color: rgba(15, 23, 42, 0.45) !important;
    }

    :root[data-theme="dark"] dialog {
        background-color: var(--sl-color-gray-6) !important;
    }

    :root[data-theme="dark"] dialog::backdrop {
        background-color: rgba(9, 13, 22, 0.75) !important;
    }

    /* Container Form Pencarian Pagefind */
    #starlight__search .pagefind-ui__form {
        position: relative !important;
        width: 100% !important;
        display: block !important;
    }

    /* Penyelarasan Ikon Kaca Pembesar (Search Magnifier Icon) */
    #starlight__search .pagefind-ui__form::before {
        content: "" !important;
        position: absolute !important;
        top: 1.625rem !important;
        transform: translateY(-50%) !important;
        left: 1.25rem !important;
        width: 1.2rem !important;
        height: 1.2rem !important;
        z-index: 5 !important;
        pointer-events: none !important;
        opacity: 0.85 !important;
        background-color: #0f172a !important;
    }

    :root[data-theme="dark"] #starlight__search .pagefind-ui__form::before {
        background-color: #cbd5e1 !important;
    }

    /* Input Field Pagefind dengan Jarak Lega antara Ikon & Ketikan */
    #starlight__search .pagefind-ui__search-input {
        font-family: var(--sl-font) !important;
        font-size: 1rem !important;
        font-weight: 600 !important;
        color: #0f172a !important;
        border: 2px solid var(--sl-color-hairline) !important;
        box-shadow: 3px 3px 0px var(--pk-shadow) !important;
        border-radius: 0.5rem !important;
        background: #ffffff !important;
        height: 3.25rem !important;
        line-height: 3.25rem !important;
        padding-top: 0 !important;
        padding-bottom: 0 !important;
        /* Jarak lega 60px (3.75rem): icon ada di 20px-39px, teks mulai di 60px -> ada 21px jarak bersih */
        padding-left: 3.75rem !important;
        padding-right: 3.25rem !important;
        width: calc(100% - var(--sl-search-cancel-space, 0px)) !important;
        box-sizing: border-box !important;
        transform: translate(0, 0);
        transition:
            transform 120ms ease,
            box-shadow 120ms ease,
            border-color 120ms ease !important;
    }

    :root[data-theme="dark"] #starlight__search .pagefind-ui__search-input {
        color: var(--sl-color-white) !important;
        background: var(--sl-color-black) !important;
    }

    #starlight__search .pagefind-ui__search-input:focus {
        border-color: var(--sl-color-accent) !important;
        outline: none !important;
        box-shadow: 4px 4px 0px var(--sl-color-accent) !important;
    }

    /* Penyelarasan Tombol Clear (X) di Sebelah Kanan Input */
    #starlight__search .pagefind-ui__search-clear {
        position: absolute !important;
        top: 1.625rem !important;
        transform: translateY(-50%) !important;
        right: 0.85rem !important;
        height: 1.85rem !important;
        width: 1.85rem !important;
        padding: 0 !important;
        display: flex !important;
        align-items: center !important;
        justify-content: center !important;
        background: transparent !important;
        border: 0 !important;
        z-index: 5 !important;
        cursor: pointer !important;
    }

    /* Wadah Saran Pencarian Tepat di Bawah Inputan */
    .pk-search-suggestions {
        display: flex;
        flex-direction: column;
        gap: 0.55rem;
        padding: 0.75rem 0.85rem;
        border: 2px solid var(--sl-color-hairline);
        border-radius: 0.5rem;
        background-color: #f1f5f9;
        box-shadow: 3px 3px 0px var(--pk-shadow);
        margin: 0.75rem 0;
    }

    :root[data-theme="dark"] .pk-search-suggestions {
        background-color: var(--sl-color-black);
        border-color: var(--sl-color-hairline);
    }

    .pk-suggestions-header {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        font-size: 0.75rem;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        color: var(--sl-color-gray-3);
    }

    .pk-suggestions-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 1rem;
        height: 1rem;
        color: var(--sl-color-orange);
        flex-shrink: 0;
    }

    .pk-suggestions-icon svg {
        display: block;
    }

    .pk-suggestions-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 0.45rem;
    }

    /* Chip Saran Interaktif (Animasi Neobrutalism Terbenam saat Hover) */
    .pk-suggestion-chip {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.45rem;
        padding: 0.35rem 0.65rem;
        border-radius: 0.375rem;
        border: 2px solid var(--sl-color-hairline);
        background-color: #ffffff;
        box-shadow: 2px 2px 0px var(--pk-shadow);
        color: #0f172a;
        font-family: var(--sl-font);
        font-size: 0.8rem;
        font-weight: 700;
        line-height: 1;
        cursor: pointer;
        transform: translate(0, 0);
        transition:
            transform 120ms cubic-bezier(0.16, 1, 0.3, 1),
            box-shadow 120ms cubic-bezier(0.16, 1, 0.3, 1),
            border-color 120ms ease,
            color 120ms ease !important;
    }

    :root[data-theme="dark"] .pk-suggestion-chip {
        background-color: var(--sl-color-gray-6);
        color: var(--sl-color-white);
    }

    /* Ikon di dalam Chip (Presisi Vertikal & Horisontal) */
    .pk-chip-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 0.95rem;
        height: 0.95rem;
        flex-shrink: 0;
        color: var(--sl-color-accent);
    }

    .pk-chip-icon svg {
        display: block;
        width: 100%;
        height: 100%;
    }

    .pk-chip-label {
        display: inline-block;
        line-height: 1.2;
    }

    /* Hover: Animasi Neobrutalism seolah terbenam */
    .pk-suggestion-chip:hover {
        transform: translate(1.5px, 1.5px) !important;
        box-shadow: 0.5px 0.5px 0px var(--pk-shadow) !important;
        border-color: var(--sl-color-accent) !important;
        color: var(--sl-color-accent) !important;
    }

    .pk-suggestion-chip:active {
        transform: translate(2px, 2px) !important;
        box-shadow: 0px 0px 0px !important;
    }

    /* Hasil Pencarian Pagefind */
    #starlight__search .pagefind-ui__result {
        border: 2px solid var(--sl-color-hairline) !important;
        border-radius: 0.5rem !important;
        background: #ffffff !important;
        box-shadow: 3px 3px 0px var(--pk-shadow) !important;
        margin-bottom: 0.75rem !important;
        overflow: hidden !important;
        padding: 0 !important; /* Preservasi layout icon dokumen bawaan Starlight */
        transition:
            transform 120ms cubic-bezier(0.16, 1, 0.3, 1),
            box-shadow 120ms cubic-bezier(0.16, 1, 0.3, 1),
            border-color 120ms ease !important;
    }

    :root[data-theme="dark"] #starlight__search .pagefind-ui__result {
        background: var(--sl-color-gray-6) !important;
    }

    #starlight__search .pagefind-ui__result:hover {
        transform: translate(1.5px, 1.5px) !important;
        box-shadow: 1.5px 1.5px 0px var(--pk-shadow) !important;
        border-color: var(--sl-color-accent) !important;
    }

    #starlight__search .pagefind-ui__result-link {
        color: #0f172a !important;
        font-weight: 800 !important;
    }

    :root[data-theme="dark"] #starlight__search .pagefind-ui__result-link {
        color: var(--sl-color-white) !important;
    }
</style>
