# ==============================================================================
# Pasak Documentation Site Environment Config
# ==============================================================================

# URL Utama Situs Dokumentasi (digunakan oleh Astro untuk Canonical & Sitemap)
SITE_URL=https://pasak.is-a.dev

# ==============================================================================
# Integrasi Pelacak Pengunjung (Superapp API Telemetry)
# ==============================================================================
# Endpoint API penerima rekaman kunjungan
PUBLIC_VISITOR_API_URL=

# Identifier unik situs untuk segmentasi statistik pengunjung
PUBLIC_VISITOR_SITE_ID=pasak
