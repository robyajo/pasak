# ==============================================================================
# Laravel Security Monitor Documentation Site Environment Config
# ==============================================================================

# URL Utama Situs Dokumentasi (digunakan oleh Astro untuk Canonical & Sitemap)
SITE_URL=https://security-dev.pekanbaru.go.id

# ==============================================================================
# Integrasi Pelacak Pengunjung (Superapp API Telemetry)
# ==============================================================================
# Endpoint API penerima rekaman kunjungan
PUBLIC_VISITOR_API_URL=https://superapp-api.pekanbaru.go.id/api/master/visitors

# Identifier unik situs untuk segmentasi statistik pengunjung
PUBLIC_VISITOR_SITE_ID=laravel-security-monitor
