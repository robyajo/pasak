# ==============================================================================
# KONFIGURASI LLM STRIX AI PENTEST (AUTONOMOUS AGENT)
# Mendukung: Google Gemini, OpenAI (ChatGPT), OpenRouter, dan OpenCode / Local AI
# ==============================================================================

# Model Aktif yang Digunakan Strix:
# - Gemini: "gemini/gemini-2.5-pro", "gemini/gemini-2.5-flash", "gemini/gemini-1.5-pro"
# - ChatGPT: "openai/gpt-4o", "openai/gpt-4o-mini", "openai/o3-mini"
# - OpenRouter: "openrouter/z-ai/glm-5.3", "openrouter/anthropic/claude-3.5-sonnet"
# - OpenCode / Local (Ollama): "openai/qwen2.5-coder", "openai/deepseek-coder"
STRIX_LLM="openrouter/z-ai/glm-5.3"

# 1. Kunci API Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY="your-gemini-api-key"

# 2. Kunci API OpenAI / ChatGPT (https://platform.openai.com/api-keys)
OPENAI_API_KEY="your-openai-api-key"

# 3. Kunci API OpenRouter / OpenCode (https://openrouter.ai/keys)
OPENROUTER_API_KEY="your-api-key"
LLM_API_KEY="your-api-key"

# 4. (Opsional) Endpoint Kustom / OpenCode / Ollama / LocalAI:
# OPENAI_API_BASE="http://localhost:11434/v1"

# 5. Opsi Bin & Direktori:
STRIX_BIN="strix/.venv/bin/strix"
# STRIX_RUNS_DIR="strix_runs"
