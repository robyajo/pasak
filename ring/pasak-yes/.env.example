APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pasak
# Konfigurasi Perlindungan WAF, Brute Force, dan Karantina IP

# Penegakan blokir: Tolak request dari IP yang terblokir dengan respons HTTP 403

# Pemblokiran otomatis berjenjang: Blokir IP jika jumlah ancaman mencapai threshold.
# Default MATI (monitoring saja): tidak ada blokir otomatis sampai Anda mengaktifkannya.
# Jumlah pelanggaran ancaman sebelum IP diblokir (default: 3 kali)
# Jendela waktu akumulasi evaluasi ancaman dalam satuan menit (default: 10 menit)
# Durasi masa blokir otomatis dalam satuan jam (default: 24 jam)
# Lingkup pemblokiran otomatis: 'device' (hanya perangkat penyerang, aman untuk WiFi bersama) atau 'ip' (seluruh router)
# Level ancaman yang dihitung menuju ambang auto-block, dipisahkan koma (low,medium,high,critical)

# Pemblokiran instan (Zero Tolerance): Langsung blokir pada percobaan pertama
# untuk serangan fatal (webshell, null byte, double extension .php.jpg, akses .env/.git).
# Default MATI (monitoring saja): aktifkan bila Anda siap melakukan karantina otomatis.
# Durasi masa blokir instan dalam satuan jam (default: 720 jam = 30 hari)
# Lingkup pemblokiran instan: 'device' (hanya perangkat penyerang, aman untuk WiFi bersama) atau 'ip' (seluruh router)

# Proteksi brute force login bertingkat (cooldown 1m, 5m, 15m, hingga 24 jam)
# Batas kegagalan login berturut-turut sebelum dikenakan penundaan pertama
# Durasi penundaan (cooldown) awal dalam satuan menit
# Batas durasi maksimal penundaan dalam satuan menit
# Waktu peluruhan riwayat kegagalan jika tidak ada percobaan baru (dalam menit)

# Masa retensi berkas log audit keamanan dalam satuan hari (dibersihkan via pasak:prune-logs)

# Daftar putih IP yang tidak akan pernah diblokir (pisahkan dengan koma jika lebih dari satu)

# Rute REST API headless (/api/security/*): Set false jika aplikasi hanya menggunakan rute web biasa

# Dashboard monitoring Blade murni (fitur visual di prefix /pasak, wajib login pengguna)
# Publikasikan tampilannya dengan:
#   php artisan pasak:install --with-dashboard (atau --tag=plain-views)
# Driver dashboard (selalu "blade" — dipertahankan untuk kompatibilitas)

# Banner + dialog pengumuman otomatis di halaman utama (/): set false untuk menonaktifkan

# Pemeriksaan versi otomatis dan notifikasi pembaruan saat menjalankan serve / composer run dev


# ---------------------------------------------------------------------------
# Pasak — variabel inti (core)
#
# Cukup ini saja di .env. Seluruh perilaku keamanan lainnya (ambang
# auto-block, blokir instan, jendela waktu, durasi, tingkat ancaman,
# proteksi brute force login, retensi log, dan pengumuman) diatur dari
# dashboard Pasak → menu Pengaturan, tersimpan di database, dilengkapi
# nilai bawaan yang wajar. Kunci PASAK_* lama di luar daftar ini tetap
# dihargai sebagai override manual bila sudah ada, tetapi tidak wajib.
# ---------------------------------------------------------------------------

# Sakelar utama WAF: Aktifkan (true) atau nonaktifkan (false) seluruh inspeksi keamanan
PASAK_MONITOR_ENABLED=true

# Daftar putih IP yang tidak akan pernah diblokir (pisahkan dengan koma jika lebih dari satu).
# Wajib diisi IP admin/kantor agar pembaru tidak mengunci sendiri saat dashboard tak terjangkau.
PASAK_IP_WHITELIST=127.0.0.1,::1

# Sakelar pendaftaran middleware WAF otomatis ke HTTP Kernel (untuk host yg tidak menyunting
# kernel manual; pasak:install biasanya sudah menyuntikkannya — biarkan false agar tidak dobel)
PASAK_AUTO_REGISTER_MIDDLEWARE=false

# Rute REST API headless (/api/pasak/*): Set false jika aplikasi hanya menggunakan rute web biasa
PASAK_ROUTES_ENABLED=true

# Dashboard monitoring Blade murni (fitur visual pada /pasak, wajib login pengguna).
# Publikasikan tampilannya dengan: php artisan pasak:install --with-dashboard (atau --tag=plain-views)
PASAK_DASHBOARD_ENABLED=true
# Awalan URL dashboard monitoring (default: pasak) -> diakses pada /pasak
PASAK_DASHBOARD_PREFIX=pasak
# Batasi akses dashboard hanya untuk akun ber-role admin (default: false, cukup login)
PASAK_DASHBOARD_ADMIN_ONLY=false

# Pesan khusus + alamat bantuan yang tampil di halaman blokir 403 (opsional)
PASAK_SUPPORT_EMAIL=security@domain-anda.test
PASAK_DASHBOARD_ROTATING=true
PASAK_DASHBOARD_TOKEN_LENGTH=16
PASAK_DASHBOARD_SINGLE_USE=true
PASAK_DASHBOARD_GRACE_SECONDS=120
PASAK_DASHBOARD_SECRET=BCAMXKSuDcoCtN0a5kyb7RKiYJzEDcHKkPeKFWaDM3i670FY
