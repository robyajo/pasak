APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"


# ---------------------------------------------------------------------------
# Pasak — variabel inti (core)
#
# Cukup ini saja di .env. Seluruh perilaku keamanan lainnya (ambang
# auto-block, blokir instan, jendela waktu, durasi, tingkat ancaman,
# proteksi brute force login, retensi log, dan pengumuman) diatur dari
# dashboard Pasak → menu Pengaturan, tersimpan di database, dilengkapi
# nilai bawaan yang wajar. Kunci PASAK_* lama di luar daftar ini tetap
# dihargai sebagai override manual bila sudah ada, tetapi tidak wajib.
# ---------------------------------------------------------------------------

# Sakelar utama WAF: Aktifkan (true) atau nonaktifkan (false) seluruh inspeksi keamanan
PASAK_MONITOR_ENABLED=true

# Daftar putih IP yang tidak akan pernah diblokir (pisahkan dengan koma jika lebih dari satu).
# Wajib diisi IP admin/kantor agar pembaru tidak mengunci sendiri saat dashboard tak terjangkau.
PASAK_IP_WHITELIST=127.0.0.1,::1

# Sakelar pendaftaran middleware WAF otomatis ke HTTP Kernel (untuk host yg tidak menyunting
# kernel manual; pasak:install biasanya sudah menyuntikkannya — biarkan false agar tidak dobel)
PASAK_AUTO_REGISTER_MIDDLEWARE=false

# Rute REST API headless (/api/pasak/*): Set false jika aplikasi hanya menggunakan rute web biasa
PASAK_ROUTES_ENABLED=true

# Dashboard monitoring Blade murni (fitur visual pada /pasak, wajib login pengguna).
# Publikasikan tampilannya dengan: php artisan pasak:install --with-dashboard (atau --tag=plain-views)
PASAK_DASHBOARD_ENABLED=true
# Awalan URL dashboard monitoring (default: pasak) -> diakses pada /pasak
PASAK_DASHBOARD_PREFIX=pasak
# Kredensial autentikasi form login mandiri dashboard Pasak:
# Username untuk login ke dashboard (default: admin)
PASAK_DASHBOARD_USERNAME=admin
# Password default awal sebelum diganti dan disimpan ke database (default: Admin)
PASAK_DASHBOARD_PASSWORD=Admin
# URL acak sekali pakai: /pasak stabil 302 ke /pasak-{token}/ milik sesi tiap user.
# Token diputar setiap akses HTML sehingga reload selalu berubah
# (mis. /pasak-95856857476jdhjs5/logs lalu /pasak-634664873647jbdjshf/threat-map).
# Diisi otomatis oleh pasak:install saat dashboard dipasang; kosongkan (false) untuk prefix statis.
PASAK_DASHBOARD_ROTATING=true
# Rahasia penanda tangan token dashboard (dibuat otomatis saat install, jangan disebar).
# Hanya ditulis ke .env. Setelah clone/deploy baru: php artisan pasak:deploy (atau pasak:secret)
PASAK_DASHBOARD_SECRET=
# Panjang token acak (12-32, default 16) + masa tenggang URL lama (detik, default 120).
PASAK_DASHBOARD_TOKEN_LENGTH=16
PASAK_DASHBOARD_SINGLE_USE=true
PASAK_DASHBOARD_GRACE_SECONDS=120
# Batasi akses dashboard hanya untuk akun ber-role admin (default: false, cukup login)
PASAK_DASHBOARD_ADMIN_ONLY=false

# Pesan khusus + alamat bantuan yang tampil di halaman blokir 403 (opsional)
PASAK_SUPPORT_EMAIL=security@domain-anda.test

# ---------------------------------------------------------------------------
# Pasak Cloud SOC & Sentinel Fleet Monitoring
# ---------------------------------------------------------------------------
# Kunci lisensi langganan Pasak Cloud SOC (contoh: psk_live_...)
# Menggunakan APP_NAME dan APP_URL untuk registrasi armada & pemantauan terpusat.
PASAK_CLOUD_KEY=

# Pasak Sentinel Host Daemon (Unix Domain Socket IPC)
PASAK_SENTINEL_ENABLED=true
PASAK_SENTINEL_SOCKET=/run/pasak/agent.sock
